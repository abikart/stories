{
  "name": "stories-sh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync:soft-components",
    "dev": "next dev",
    "prebuild": "npm run sync:soft-components",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "narrate:performance": "tsx scripts/narrate-performance.ts",
    "soundscape": "tsx scripts/generate-soundscape.ts",
    "derive:alpha": "uv run --with numpy --with scipy python scripts/derive-connected-alpha.py",
    "lint:experiences": "tsx scripts/lint-experience.ts",
    "qa:design-system": "tsx scripts/qa-design-system.ts",
    "qa:soft-components": "tsx scripts/qa-soft-components.ts",
    "qa:experience": "tsx scripts/qa-experience-playback.ts",
    "qa:experience:webkit": "tsx scripts/qa-experience-playback.ts --browser=webkit",
    "evidence:design-system": "tsx scripts/capture-design-system-evidence.ts",
    "evidence:soft-components": "tsx scripts/capture-soft-components-evidence.ts",
    "sync:soft-components": "node scripts/sync-soft-components-dist.mjs",
    "update:soft-components": "npm --prefix src/design-system/soft-components run update:upstream --",
    "ingest:experience-video": "tsx scripts/ingest-experience-video.ts"
  },
  "dependencies": {
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
